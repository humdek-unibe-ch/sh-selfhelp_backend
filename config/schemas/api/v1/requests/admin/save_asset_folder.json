{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Save Asset Folder Request",
  "description": "Create, rename or move an asset folder (organisation only)",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "parent_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Parent folder; null = top level"
    }
  },
  "additionalProperties": false
}
