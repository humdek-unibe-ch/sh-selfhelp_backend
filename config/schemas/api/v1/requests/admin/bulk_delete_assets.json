{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Bulk Delete Assets Request",
  "description": "Delete several assets at once",
  "required": [
    "asset_ids"
  ],
  "properties": {
    "asset_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "additionalProperties": false
}
