{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Bulk Move Assets Request",
  "description": "Move several assets into one folder; folder_id null = the top level",
  "required": [
    "asset_ids",
    "folder_id"
  ],
  "properties": {
    "asset_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "folder_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "additionalProperties": false
}
