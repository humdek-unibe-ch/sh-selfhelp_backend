{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Bulk Update Asset Groups Request",
  "description": "Add or remove groups on several assets at once",
  "required": ["asset_ids", "group_ids", "mode"],
  "properties": {
    "asset_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "type": "integer", "minimum": 1 }
    },
    "group_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "mode": {
      "type": "string",
      "enum": ["add", "remove"]
    }
  },
  "additionalProperties": false
}
