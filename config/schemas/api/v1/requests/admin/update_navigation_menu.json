{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Update navigation menu definition",
    "type": "object",
    "properties": {
        "preset": { "type": "string" },
        "max_depth": { "type": ["integer", "null"] },
        "item_limit": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 50,
            "description": "Max root menu items rendered for this menu. null = unlimited. Soft: extras stay stored but are not rendered."
        },
        "children_nav": { "enum": ["sidebar", "pills", "none", null] },
        "show_breadcrumbs": { "type": "boolean" },
        "show_pager": { "type": "boolean" }
    },
    "additionalProperties": false
}
