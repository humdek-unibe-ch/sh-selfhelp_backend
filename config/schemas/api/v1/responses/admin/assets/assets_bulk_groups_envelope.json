{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Asset Bulk Groups Response Envelope",
  "description": "Result of adding or removing groups on several assets",
  "allOf": [
    { "$ref": "../../common/_response_envelope.json" }
  ],
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "updated": { "type": "integer", "minimum": 0, "description": "Number of assets updated" }
      },
      "required": ["updated"],
      "additionalProperties": false
    }
  },
  "required": ["data"]
}
