{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Group Response",
  "description": "Response schema for single group",
  "properties": {
    "id": { "type": "integer", "description": "Group ID" },
    "name": { "type": "string", "description": "Group name" },
    "description": { "type": "string", "description": "Group description" },
    "requires_2fa": { "type": "boolean", "description": "Whether the group requires 2FA" },
    "add_to_new_pages": { "type": "boolean", "description": "Whether every new public page gives this group `select`" },
    "users_count": { "type": "integer", "description": "Number of users in the group" },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "User ID" },
          "email": { "type": "string", "description": "User email" },
          "name": { "type": ["string", "null"], "description": "User name" }
        },
        "required": ["id", "email"],
        "additionalProperties": false
      }
    },
    "acls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page_id": { "type": "integer", "description": "Page ID" },
          "page_keyword": { "type": "string", "description": "Page keyword" },
          "page_url": { "type": ["string", "null"], "description": "Page URL" },
          "acl_select": { "type": "boolean", "description": "Whether members may see this page" }
        },
        "required": ["page_id", "page_keyword", "acl_select"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "name", "description", "requires_2fa", "add_to_new_pages", "users_count", "users", "acls"],
  "additionalProperties": false
}
