{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Role Response",
  "description": "Response schema for single role",
  "properties": {
    "id": { "type": "integer", "description": "Role ID" },
    "name": { "type": "string", "description": "Role name" },
    "description": { "type": ["string", "null"], "description": "Role description" },
    "is_superuser": { "type": "boolean", "description": "Whether this role passes every access check (F10)" },
    "permissions_count": { "type": "integer", "description": "Number of permissions in the role" },
    "users_count": { "type": "integer", "description": "Number of users with this role" },
    "can_update": { "type": "boolean", "description": "Whether the caller may update this role (rule 4.6f + admin.role.update)" },
    "can_delete": { "type": "boolean", "description": "Whether the caller may delete this role (rule 4.6f + admin.role.delete, no users, not superuser)" },
    "fully_held": { "type": "boolean", "description": "Whether the caller holds every permission and every grant bit of this role, so may hand it out (rule 4.6f); a superuser caller: true for every role; a caller who is not superuser: false for the superuser role" },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "Permission ID" },
          "name": { "type": "string", "description": "Permission name" },
          "description": { "type": ["string", "null"], "description": "Permission description" }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "User ID" },
          "email": { "type": "string", "description": "User email" },
          "name": { "type": ["string", "null"], "description": "User name" }
        },
        "required": ["id", "email"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "name", "is_superuser", "permissions_count", "users_count", "can_update", "can_delete", "fully_held", "permissions", "users"],
  "additionalProperties": false
}
