{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Form List History Response",
  "description": "A page of the revisions of a record shown in a list, newest first. Only fields the list or its form shows are named; files are described, never exposed by path.",
  "allOf": [
    {
      "$ref": "../common/_response_envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "required": ["items", "total", "page", "page_size", "current_version"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "content_ref": { "$ref": "../common/_content_ref.json" }
                }
              }
            },
            "total": { "type": "integer", "minimum": 0 },
            "page": { "type": "integer", "minimum": 1 },
            "page_size": { "type": "integer", "minimum": 1 },
            "current_version": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "required": ["data"]
    }
  ]
}
