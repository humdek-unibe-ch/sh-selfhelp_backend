                "status"
            ],
            "rows": [
                {
                    "author": "Lena Baumann",
                    "quote": {
                        "en-GB": "The weekly check-ins take me two minutes on my phone. It is the first study where I never felt like the technology was in the way.",
                        "de-CH": "Die wöchentlichen Check-ins dauern auf dem Handy zwei Minuten. Es ist die erste Studie, bei der mir die Technik nie im Weg stand."
                    },
                    "role": {
                        "de-CH": "Studienteilnehmerin, Welle 2",
                        "en-GB": "Study participant, wave 2"
                    },
                    "status": "Approved"
                },
                {
                    "author": "Dr. Samuel Frei",
                    "quote": {
                        "en-GB": "Our coordinators build and translate new questionnaires themselves. What used to be a two-week IT ticket is now an afternoon of clicking.",
                        "de-CH": "Unsere Koordinatorinnen erstellen und übersetzen neue Fragebögen selbst. Was früher ein zweiwöchiges IT-Ticket war, ist jetzt ein Nachmittag Klickarbeit."
                    },
                    "role": {
                        "de-CH": "Hauptprüferin Kardiologie",
                        "en-GB": "Principal Investigator, cardiology"
                    },
                    "status": "Approved"
                },
                {
                    "author": "Priya Sharma",
                    "quote": {
                        "en-GB": "Importing a template gave us a working participant portal in one morning — list page, detail pages and the admin grid included.",
                        "de-CH": "Der Import einer Vorlage lieferte uns an einem Vormittag ein funktionierendes Teilnehmerportal — mit Listen-, Detailseiten und Admin-Grid."
                    },
                    "role": {
                        "de-CH": "Studienkoordinatorin",
                        "en-GB": "Research coordinator"
                    },
                    "status": "Approved"
                },
                {
                    "author": "Thomas Egli",
                    "quote": {
                        "en-GB": "One backend, one frontend, versioned plugins. It slots into our infrastructure without any special cases.",
                        "de-CH": "Ein Backend, ein Frontend, versionierte Plugins. Es fügt sich ohne Sonderfälle in unsere Infrastruktur ein."
                    },
                    "role": {
                        "de-CH": "IT-Support-Leitung",
                        "en-GB": "IT support lead"
                    },
                    "status": "Approved"
                },
                {
                    "author": "Camille Rochat",
                    "quote": {
                        "en-GB": "I can read everything in French while the team works in German. The switch is seamless.",
                        "de-CH": "Ich kann alles auf Französisch lesen, während das Team auf Deutsch arbeitet. Der Wechsel ist nahtlos."
                    },
                    "role": {
                        "de-CH": "Studienteilnehmende, Pilotgruppe",
                        "en-GB": "Study participant, pilot group"
                    },
                    "status": "Pending"
                },
                {
                    "author": "Prof. Anna Vogel",
                    "quote": {
                        "en-GB": "The audit trail and permission model convinced our data protection office on the first review.",
                        "de-CH": "Audit-Trail und Berechtigungsmodell haben unser Datenschutzteam bei der ersten Prüfung überzeugt."
                    },
                    "role": {
                        "de-CH": "Forschungsgruppenleitung",
                        "en-GB": "Head of research group"
                    },
                    "status": "Approved"
                }
            ]
        }
